# FinAlly — environment variables
# See planning/PLAN.md §5 for full env-var contract.

# Required: OpenRouter API key for LLM chat functionality.
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Leave blank to use the built-in simulator (recommended for most users).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses (used by E2E tests).
LLM_MOCK=false
