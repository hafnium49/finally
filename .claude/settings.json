{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "hooks": {
      "Stop": [
          {
              "hooks": [
                  {
                      "type": "command",
                      "command": "codex exec \"Review planning/PLAN.md and write results to a file named planning/plan-review-$(date +%Y%m%d-%H%M%S).md\" >/dev/null 2>&1 &"
                  }
              ]
          }
      ]
  }
}